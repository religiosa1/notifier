{
  "name": "@tg-notifier/server",
  "version": "2.0.0",
  "description": "Telegram notifier bot",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "author": "Viacheslav Azarov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/religiosa1/notifier.git"
  },
  "scripts": {
    "dev": "tsx watch index.ts",
    "debug": "tsx --inspect-brk index.ts",
    "build": "tsup ./index.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "salt": "tsx scripts/salt.ts",
    "generate-jwt-secret": "tsx scripts/generate-jwt-secret.ts",
    "db:make-migration": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "tsx scripts/db-migrate",
    "db:seed": "tsx scripts/db-seed.ts",
    "test": "vitest --run"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.2.2",
    "@tsconfig/node-lts": "^20.1.3",
    "@tsconfig/strictest": "^2.0.5",
    "@types/connect": "^3.4.38",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.32.0",
    "node-telegram-bot-api": "^0.66.0",
    "pino": "^9.2.0",
    "rfc4648": "^1.5.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hono/node-server": "^1.12.0",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/node-telegram-bot-api": "^0.64.7",
    "drizzle-kit": "^0.23.0",
    "hono": "^4.4.13",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.2"
  }
}
