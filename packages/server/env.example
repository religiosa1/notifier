# This is an example of .env file, you can use to setup the service.

PUBLIC_URL=https://example.com/
BOT_TOKEN=1234567890:this_is_your_bot_token_as_given_by_telegrams_botfather
JWT_SECRET=generate_your_token_with_npm_run_generate-jwt-secret_and_paste_it_here

# Optional (but recommended) TG_HOOK_SECRET if you want to authorize requests 
# arriving at webhook endpoint 
# See https://core.telegram.org/bots/api#setwebhook secret_token
TG_HOOK_SECRET=HERE GOES YOUR TELEGRAM SECRET (AS SPECIFIED IN BOTFATHER SETTINGS)

# Optional for overriding some of the settings
DB_FILE=/some-other-location/of-db.sqlite3

# Optional for seeding
NOTIFIER_ADMIN_PWD=123456
NOTIFIER_ADMIN_TGID=123456
